# Postgres
DATABASE_URL=postgres://user:pass@localhost:5432/matchday

# Payments — decide in week 0, do not let it block the venue conversation (Z1)
PAYMENTS_PROVIDER=
PAYMENTS_SECRET_KEY=

# WhatsApp Business API — the 18:00 team sheet drop (O6)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=

# Bump on every change to src/engine/weights.ts so old rating_events stay
# explainable and two weight sets can be compared over the same history.
WEIGHTS_VERSION=2026.09.1

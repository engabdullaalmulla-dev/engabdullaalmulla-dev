; Salary to Skyline — Godot project configuration.
; Engine pinned at M0: Godot 4.7.2 stable (official build ed1daf0bf).
; Portrait-first phone target. See docs/decisions/0001-engine-pin.md.

config_version=5

[application]

config/name="Salary to Skyline"
config/description="M0 foundation build. Working title, not a cleared brand. All money in this game is simulated and has no cash value."
config/version="0.0.1-m0"
run/main_scene="res://game/presentation/main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/quit_on_go_back=false
boot_splash/show_image=false
config/icon="res://assets/branding/icon.svg"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=480
window/size/window_height_override=854
window/handheld/orientation=1
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/vsync/vsync_mode=1

[gui]

theme/default_font_multichannel_signed_distance_field=true
theme/default_font_subpixel_positioning=1

[internationalization]

locale/translations_pot_files=PackedStringArray()
rendering/text_driver="TextServerAdvanced"

[rendering]

renderer/rendering_method="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.055, 0.067, 0.094, 1)
anti_aliasing/quality/msaa_2d=0
